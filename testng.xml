
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SauceDemo QA Suite" verbose="2">
    <listeners>
        <listener class-name="com.qa.tests.reporting.FailureScreenshotListener"/>
    </listeners>

    <test name="Smoke - Chromium">
        <parameter name="browser" value="chromium"/>
        <groups>
            <run><include name="smoke"/></run>
        </groups>
        <classes>
            <class name="com.qa.tests.ui.LoginTest"/>
            <class name="com.qa.tests.ui.InventoryTest"/>
            <class name="com.qa.tests.ui.CartTest"/>
        </classes>
    </test>

    <test name="Smoke - Firefox">
        <parameter name="browser" value="firefox"/>
        <groups>
            <run><include name="smoke"/></run>
        </groups>
        <classes>
            <class name="com.qa.tests.ui.LoginTest"/>
            <class name="com.qa.tests.ui.InventoryTest"/>
            <class name="com.qa.tests.ui.CartTest"/>
        </classes>
    </test>

    <test name="Smoke - WebKit">
        <parameter name="browser" value="webkit"/>
        <groups>
            <run><include name="smoke"/></run>
        </groups>
        <classes>
            <class name="com.qa.tests.ui.LoginTest"/>
            <class name="com.qa.tests.ui.InventoryTest"/>
            <class name="com.qa.tests.ui.CartTest"/>
        </classes>
    </test>

    <test name="Sanity - Chromium">
        <parameter name="browser" value="chromium"/>
        <classes>
            <class name="com.qa.tests.ui.InventoryTest">
                <methods><include name="inventoryTest"/></methods>
            </class>
            <class name="com.qa.tests.ui.CartTest">
                <methods><include name="addProductToCart"/></methods>
            </class>
        </classes>
    </test>

    <test name="Sanity - Firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.qa.tests.ui.InventoryTest">
                <methods><include name="verifyProductSorting"/></methods>
            </class>
        </classes>
    </test>

    <test name="Sanity - WebKit">
        <parameter name="browser" value="webkit"/>
        <classes>
            <class name="com.qa.tests.ui.CartTest">
                <methods><include name="addMultipleProductsToCart"/></methods>
            </class>
        </classes>
    </test>
</suite>

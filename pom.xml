<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.qa</groupId>
    <artifactId>saucedemo-qa-framework</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <playwright.version>1.55.0</playwright.version>
        <appium.version>10.1.1</appium.version>
        <selenium.version>4.49.0</selenium.version>
        <testng.version>7.11.0</testng.version>
        <allure.testng.version>2.29.1</allure.testng.version>
        <gson.version>2.13.2</gson.version>
        <poi.version>5.4.1</poi.version>
        <aws.sdk.version>2.57.8</aws.sdk.version>

        <!-- Allure version retained for API and Mobile reports -->
        <allure.report.version>3.17.0</allure.report.version>

        <!-- TestNG parent suite -->
        <testng.suiteXmlFile>testng-all.xml</testng.suiteXmlFile>

        <!-- Combined raw Allure results -->
        <allure.results.directory>
            ${project.build.directory}/allure-results
        </allure.results.directory>

        <!-- Platform-specific Allure results -->
        <web.allure.results>
            ${project.build.directory}/reports/web/allure-results
        </web.allure.results>

        <api.allure.results>
            ${project.build.directory}/reports/api/allure-results
        </api.allure.results>

        <mobile.allure.results>
            ${project.build.directory}/reports/mobile/allure-results
        </mobile.allure.results>

        <!-- Platform-specific HTML reports -->
        <web.allure.report>
            ${project.build.directory}/reports/web/allure-report
        </web.allure.report>

        <api.allure.report>
            ${project.build.directory}/reports/api/allure-report
        </api.allure.report>

        <mobile.allure.report>
            ${project.build.directory}/reports/mobile/allure-report
        </mobile.allure.report>

        <!-- Execution metadata -->
        <execution.id>local-${maven.build.timestamp}</execution.id>

        <testdata.source>local</testdata.source>
        <env>qa</env>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- Playwright UI and API automation -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <!-- Appium mobile automation -->
        <dependency>
            <groupId>io.appium</groupId>
            <artifactId>java-client</artifactId>
            <version>${appium.version}</version>
        </dependency>

        <!-- Selenium dependency used by Appium -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- TestNG -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Allure reporting -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <version>${allure.testng.version}</version>
        </dependency>

        <!-- JSON processing -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- Excel test data -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- AWS S3 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Java compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <!-- TestNG execution -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>

                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>
                            ${testng.suiteXmlFile}
                        </suiteXmlFile>
                    </suiteXmlFiles>

                    <systemPropertyVariables>
                        <allure.results.directory>
                            ${allure.results.directory}
                        </allure.results.directory>

                        <testdata.source>${testdata.source}</testdata.source>
                        <env>${env}</env>
                    </systemPropertyVariables>

                    <useSystemClassLoader>true</useSystemClassLoader>
                    <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>

                    <!-- Continue to reporting even when tests fail.
                         ReportingPipelineFinalizer returns the final
                         failed build status after upload. -->
                    <testFailureIgnore>true</testFailureIgnore>
                </configuration>
            </plugin>

            <!-- Generate independent Web, API and Mobile Allure reports -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>3.1.0</version>

                <configuration>
                    <reportTimeout>300</reportTimeout>
                </configuration>

                <executions>

                    <!-- Web Allure report: use Allure 2 -->
                    <execution>
                        <id>generate-web-allure-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <reportVersion>2.39.0</reportVersion>
                            <resultsDirectory>
                                ${web.allure.results}
                            </resultsDirectory>
                            <reportDirectory>
                                ${web.allure.report}
                            </reportDirectory>
                        </configuration>
                    </execution>

                    <!-- API Allure report: retain Allure 3 -->
                    <execution>
                        <id>generate-api-allure-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <reportVersion>${allure.report.version}</reportVersion>
                            <resultsDirectory>
                                ${api.allure.results}
                            </resultsDirectory>
                            <reportDirectory>
                                ${api.allure.report}
                            </reportDirectory>
                        </configuration>
                    </execution>

                    <!-- Mobile Allure report: retain Allure 3 -->
                    <execution>
                        <id>generate-mobile-allure-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <reportVersion>${allure.report.version}</reportVersion>
                            <resultsDirectory>
                                ${mobile.allure.results}
                            </resultsDirectory>
                            <reportDirectory>
                                ${mobile.allure.report}
                            </reportDirectory>
                        </configuration>
                    </execution>

                </executions>
            </plugin>

            <!-- Reporting orchestration -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>

                <executions>

                    <!-- Step 1: Split combined Allure results -->
                    <execution>
                        <id>split-allure-results-by-platform</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>
                                com.qa.tests.reporting.AllureResultsSplitter
                            </mainClass>
                            <classpathScope>test</classpathScope>
                        </configuration>
                    </execution>

                    <!-- Step 2: Generate consolidated dashboard -->
                    <execution>
                        <id>generate-report-dashboard</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>
                                com.qa.tests.reporting.ReportingDashboardGenerator
                            </mainClass>
                            <classpathScope>test</classpathScope>
                        </configuration>
                    </execution>

                    <!-- Step 3: Finalize reporting and upload to S3 -->
                    <execution>
                        <id>finalize-and-upload-reporting</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>
                                com.qa.tests.reporting.ReportingPipelineFinalizer
                            </mainClass>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>${execution.id}</argument>
                            </arguments>
                        </configuration>
                    </execution>

                </executions>
            </plugin>

            <!-- Maven dependency support -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
            </plugin>

        </plugins>
    </build>

</project>
